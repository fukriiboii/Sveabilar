# Railway MySQL variables are provided automatically in the Railway service.
MYSQLHOST=your-railway-mysql-host
MYSQLPORT=3306
MYSQLDATABASE=svea_bilar
MYSQLUSER=your-railway-mysql-user
MYSQLPASSWORD=your-railway-mysql-password

MAIL_HOST=smtp.simply.com
MAIL_PORT=587
MAIL_USERNAME=info@sveabilarochdäck.se
MAIL_PASSWORD=your-production-smtp-password
MAIL_FROM=info@sveabilarochdäck.se
MAIL_REPLY_TO=info@sveabilarochdäck.se

JWT_SECRET=your-unique-production-jwt-secret
JWT_EXPIRATION=86400000

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=your-admin-email
ADMIN_PASSWORD=your-admin-password
